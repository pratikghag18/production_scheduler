# Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set to send command-bar sentences to the local model service (npm run voice:serve); unset, the bar uses the rules alone.
# VITE_VOICE_URL=/voice

# Set to use the local (whisper.cpp) recogniser for the command bar's microphone, falling back once to the browser's own; unset, the browser's recogniser is used alone.
# VITE_WHISPER_URL=/whisper
