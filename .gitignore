node_modules
dist
coverage
playwright-report
test-results

# env
.env
.env.local
.env.*.local

# supabase local state
.supabase/

# Supabase CLI scratch. `start-secrets/` holds the local stack's service_role
# key and JWT secret. They are the CLI's standard localhost values and unlock
# nothing remote, but they trip secret scanners and have no business in a repo.
supabase/.temp/

# delivery staging (see docs/agent-briefs)
_delivery/

# build caches and local run output — regenerated every run, never reviewable
# checks.txt is the Windows acceptance log (UTF-16, changes on every run);
# tsconfig.tsbuildinfo is TypeScript's incremental cache. Both were tracked
# until Aug 25 and both guarantee spurious diffs and merge conflicts.
*.tsbuildinfo
checks.txt

# Supabase Studio writes a copy of anything pasted into its SQL editor here
# ("Untitled query 481.sql" and friends). They are duplicates of files that
# already live in supabase/ -- committing one means two copies of the same
# script drifting apart, and the copy is the one nobody edits.
supabase/snippets/

# The per-machine Claude Code resume file. It says "personal -- gitignored, not
# shared" in its own first line, and it is written for whoever is sitting at
# this checkout: it names local paths, what is running on the machine, and how
# the maintainer wants a session driven. It was committed once by a `git add`
# that swept the working tree; `git rm --cached CLAUDE.local.md` takes it back
# out without deleting it from disk.
CLAUDE.local.md
